set(PDM_ENABLE_SHARED  @PDM_ENABLE_SHARED@)
set(PDM_ENABLE_STATIC  @PDM_ENABLE_STATIC@)
set(PDM_ENABLE_Fortran @PDM_ENABLE_Fortran@)
set(pdm_VERSION        @PDM_DEF_VERSION@)


set(_PDM_FIND_MODULE_DIR "${CMAKE_CURRENT_LIST_DIR}/../")
list(APPEND CMAKE_MODULE_PATH "${_PDM_FIND_MODULE_DIR}")

if (@PDM_HAVE_PTSCOTCH@)
  find_package(PTScotch REQUIRED)
endif()
if (@PDM_HAVE_PARMETIS@)
  find_package(ParMETIS REQUIRED)
endif()

list(REMOVE_ITEM CMAKE_MODULE_PATH "${_PDM_FIND_MODULE_DIR}")

if(PDM_ENABLE_SHARED)
  include("${CMAKE_CURRENT_LIST_DIR}/../pdm_shared/pdm_sharedTargets.cmake")
  if(PDM_ENABLE_Fortran)
    include("${CMAKE_CURRENT_LIST_DIR}/../pdmf_shared/pdmf_sharedTargets.cmake")
  endif()
endif()

if(PDM_ENABLE_STATIC)
  include("${CMAKE_CURRENT_LIST_DIR}/../pdm_static/pdm_staticTargets.cmake")
  if(PDM_ENABLE_Fortran)
    include("${CMAKE_CURRENT_LIST_DIR}/../pdmf_static/pdmf_staticTargets.cmake")
  endif()
endif()
