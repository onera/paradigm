#-----------------------------------------------------------------------
# this file contains the options and libraries used for
# building and linking ParaDiGM code, and is intended to be
# included in a user's Makefile from the installation
#-----------------------------------------------------------------------

CMAKE_INSTALL_PREFIX = @CMAKE_INSTALL_PREFIX@
CMAKE_BUILD_TYPE = @CMAKE_BUILD_TYPE@

PDM_ENABLE_Fortran = @PDM_ENABLE_Fortran@

PDM_ENABLE_PYTHON_BINDINGS = @PDM_ENABLE_PYTHON_BINDINGS@

PDM_ENABLE_SHARED = @PDM_ENABLE_SHARED@
PDM_ENABLE_STATIC = @PDM_ENABLE_STATIC@

PDM_ENABLE_PARMETIS = @PDM_ENABLE_PARMETIS@
#PARMETIS_LIBRARIES

PDM_ENABLE_PTSCOTCH = @PDM_ENABLE_PTSCOTCH@
#PTSCOTCH_LIBRARIES

PDM_ENABLE_LONG_G_NUM = @PDM_ENABLE_LONG_G_NUM@

PDM_ENABLE_BLASLAPACK = @PDM_ENABLE_BLASLAPACK@

PDM_ENABLE_TESTS = @PDM_ENABLE_TESTS@

PDM_ENABLE_DOC = @PDM_ENABLE_DOC@

# Compiler used
#-----------------------------------------------------------------------
CC = @CMAKE_C_COMPILER@
CXX = @CMAKE_CXX_COMPILER@
FC = @CMAKE_Fortran_COMPILER@

#MPI_Wrapper
